<?xml version="1.0" encoding="utf-8"?>
<!-- Mode selector segment: white rounded shape (tinted per mode in code) under a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_neutral">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/seg_radius" />
        </shape>
    </item>
</ripple>
