    <!-- Settings -->
    <string name="settings_title">Inställningar</string>
    <string name="cd_navigate_up">Tillbaka</string>
    <string name="settings_section_numbers">Nummer</string>
    <string name="label_prefix_internal">Prefix för internsamtal</string>
    <string name="help_prefix_internal">Läggs före numret när du trycker på Ring internt, t.ex. 03134 + 30771. Läggs inte till om numret redan börjar med prefixet eller är ett fullständigt nummer (börjar med 0 eller + och har minst 8 siffror).</string>
    <string name="label_prefix_patient">Prefix för patientsamtal</string>
    <string name="help_prefix_patient">Läggs före numret när du trycker på Ring patient. #31# döljer ditt nummer för mottagaren.</string>
    <string name="label_switchboard">Växelnummer</string>
    <string name="help_switchboard">Rings utan prefix med Ring växeln och med genvägen på appikonen.</string>
    <string name="reset_defaults">Återställ standard</string>
    <string name="confirm_reset_title">Återställ standard</string>
    <string name="confirm_reset_message">Återställa prefix och växelnummer till standardvärdena (%1$s, %2$s och %3$s)?</string>
    <string name="action_reset">Återställ</string>
    <string name="reset_done">Standardvärdena är återställda.</string>
    <string name="settings_section_call_log">Samtalslogg</string>
    <string name="hide_call_log">Dölj appens samtal i telefonens samtalslogg</string>
    <string name="hide_call_log_help">Android sparar alltid samtal i telefonens samtalslogg. När inställningen är på raderar appen efteråt de samtal som har ringts härifrån. Det sker i bakgrunden när samtalet är avslutat och kan dröja en liten stund. Samtalen kan ändå synas hos operatören, på fakturan, i en annan telefonapp med egen logg eller i en säkerhetskopia som hann skapas.</string>
    <string name="hide_call_log_dialog_title">Dölj samtal i samtalsloggen</string>
    <string name="hide_call_log_dialog_message">För att kunna radera appens samtal ur telefonens samtalslogg behöver Jobbdialer behörighet att läsa och ändra samtalsloggen.\n\nAppen raderar bara samtal som har ringts från appen. Inga uppgifter lämnar telefonen.</string>
    <string name="hide_call_log_denied">Behörigheten nekades – inställningen stängdes av.</string>
    <string name="call_log_prompt_title">Dölj appens samtal i telefonens samtalslogg?</string>
    <string name="call_log_prompt_message">Samtal som ringts från Jobbdialer kan raderas ur telefonens vanliga samtalslogg efteråt, så att jobbsamtal och privata samtal hålls isär. Det kräver behörighet att läsa och ändra samtalsloggen. Appen raderar bara sina egna samtal och inga uppgifter lämnar telefonen.\n\nDu kan ändra detta när som helst under Inställningar.</string>
    <string name="call_log_prompt_enable">Slå på</string>
    <string name="call_log_prompt_later">Inte nu</string>
    <string name="call_log_prompt_denied">Inställningen är kvar avstängd. Du kan slå på den under Inställningar.</string>
    <string name="hide_call_log_enabled">Appens samtal raderas nu ur samtalsloggen.</string>
    <string name="permission_denied_title">Behörighet saknas</string>
    <string name="permission_denied_call_log_message">Behörigheten för samtalsloggen är nekad. Du kan ge den under Appinfo → Behörigheter och sedan slå på inställningen igen.</string>
