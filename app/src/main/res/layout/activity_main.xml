<?xml version="1.0" encoding="utf-8"?>
<!-- Main window: toolbar, the three panes in a ViewFlipper, bottom tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:theme="@style/ToolbarTheme"
        android:title="@string/app_name" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pane_dial"
            layout="@layout/pane_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/pane_contacts"
            layout="@layout/pane_contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/pane_recents"
            layout="@layout/pane_recents"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:background="@color/surface_bar"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_dial"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_dialpad"
            android:text="@string/tab_dial" />

        <TextView
            android:id="@+id/tab_contacts"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_contact"
            android:text="@string/tab_contacts" />

        <TextView
            android:id="@+id/tab_recents"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_clock"
            android:text="@string/tab_recents" />
    </LinearLayout>
</LinearLayout>
