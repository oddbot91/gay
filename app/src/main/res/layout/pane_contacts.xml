<?xml version="1.0" encoding="utf-8"?>
<!-- "Kontakter" pane, anchored to the bottom (closer to the thumb): the list stacks from the
     bottom, so a short list (e.g. collapsed groups) ends right above the bottom bar with the
     "Favoriter" group last; the bottom bar holds the search field, sort button and add button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- List area: the empty text is the ListView's empty view and is centred in this area. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/contacts_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:stackFromBottom="true" />

        <TextView
            android:id="@+id/contacts_empty"
            style="@style/EmptyText" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Bottom bar: [search] [sort] [+]. Replaced by selection_bar in selection mode. -->
    <LinearLayout
        android:id="@+id/contacts_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_medium"
        android:paddingTop="@dimen/space_tiny"
        android:paddingRight="@dimen/space_small"
        android:paddingBottom="@dimen/space_tiny">

        <EditText
            android:id="@+id/search_field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/space_small"
            android:drawableTint="?android:attr/textColorSecondary"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/sort_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="@dimen/space_small"
            android:paddingRight="@dimen/space_small"
            android:textColor="@color/brand_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/fab_add"
            android:layout_width="@dimen/add_button_size"
            android:layout_height="@dimen/add_button_size"
            android:layout_marginStart="@dimen/space_tiny"
            android:background="@drawable/fab_bg"
            android:contentDescription="@string/cd_add_contact"
            android:scaleType="center"
            android:src="@drawable/ic_add"
            android:tint="@color/on_color" />
    </LinearLayout>

    <!-- Selection mode bar: [N valda] [Markera alla] [Ta bort] [Avbryt]. GONE outside selection mode. -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/add_button_size"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_medium"
        android:paddingTop="@dimen/space_tiny"
        android:paddingRight="@dimen/space_tiny"
        android:paddingBottom="@dimen/space_tiny"
        android:visibility="gone">

        <TextView
            android:id="@+id/selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/select_all"
            style="@style/SelectionBarButton"
            android:text="@string/selection_select_all" />

        <Button
            android:id="@+id/delete_selected"
            style="@style/SelectionBarButton"
            android:text="@string/action_delete"
            android:textColor="@color/destructive" />

        <Button
            android:id="@+id/cancel_selection"
            style="@style/SelectionBarButton"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
