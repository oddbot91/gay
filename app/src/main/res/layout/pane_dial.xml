<?xml version="1.0" encoding="utf-8"?>
<!-- "Ring" pane: number field, contact matches, mode selector, keypad and one call button.
     Wrapped in a ScrollView (fillViewport) so it still works on very short screens; on normal
     screens the spacer absorbs the free height and nothing scrolls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/pane_padding"
        android:paddingTop="@dimen/space_small"
        android:paddingRight="@dimen/pane_padding"
        android:paddingBottom="@dimen/pane_padding">

        <!-- Number field, centred over the full width (backspace sits next to the call button). -->
        <EditText
            android:id="@+id/number_field"
            android:layout_width="match_parent"
            android:layout_height="@dimen/number_row_height"
            android:background="@null"
            android:cursorVisible="true"
            android:gravity="center"
            android:hint="@string/number_hint"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorHint"
            android:textSize="@dimen/number_text_size" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_small" />

        <!-- Contact suggestions (T9 names + numbers), anchored at the bottom just above the mode
             selector so they grow upwards towards the number field; the best match is the last row
             (closest to the thumb). Rows are inflated from row_match.xml in code
             (DialPane.updateMatches); the container is GONE while there are no matches. -->
        <LinearLayout
            android:id="@+id/match_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_small"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Mode selector: Internt | Patient (tinted in code). With an empty field the call
             button calls the switchboard instead. -->
        <LinearLayout
            android:id="@+id/mode_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/seg_height"
            android:layout_marginBottom="@dimen/space_small"
            android:background="@drawable/seg_container"
            android:contentDescription="@string/cd_mode_selector"
            android:orientation="horizontal"
            android:padding="1dp">

            <TextView
                android:id="@+id/seg_internal"
                style="@style/ModeSegment"
                android:text="@string/mode_internal" />

            <TextView
                android:id="@+id/seg_patient"
                style="@style/ModeSegment"
                android:text="@string/mode_patient" />
        </LinearLayout>

        <!-- 3x4 keypad with T9 letters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/KeypadRow">

                <LinearLayout
                    android:id="@+id/key_1"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_2"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_2" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="ABC" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_3"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_3" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="DEF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <LinearLayout
                    android:id="@+id/key_4"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_4" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="GHI" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_5"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_5" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="JKL" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_6"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_6" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="MNO" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <LinearLayout
                    android:id="@+id/key_7"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_7" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="PQRS" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_8"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_8" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="TUV" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_9"
                    style="@style/KeypadKey">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_9" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="WXYZ" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <LinearLayout
                    android:id="@+id/key_star"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_star">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_star" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_0"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_zero">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_0" />

                    <TextView
                        style="@style/KeypadLetters"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/key_hash"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_hash">

                    <TextView
                        style="@style/KeypadDigit"
                        android:text="@string/key_hash" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom row: a square backspace button on the left and the single call button (tinted
             in code: switchboard colour when the field is empty, else the selected mode's colour). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backspace"
                android:layout_width="@dimen/call_button_min_height"
                android:layout_height="@dimen/call_button_min_height"
                android:layout_marginEnd="@dimen/backspace_gap"
                android:background="@drawable/btn_backspace"
                android:contentDescription="@string/cd_backspace"
                android:hapticFeedbackEnabled="true"
                android:scaleType="center"
                android:src="@drawable/ic_backspace"
                android:tint="?android:attr/textColorPrimary" />

            <LinearLayout
                android:id="@+id/call_button"
                style="@style/CallButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_call">

                <TextView
                    android:id="@+id/call_title"
                    style="@style/CallButtonTitle" />

                <TextView
                    android:id="@+id/call_sub"
                    style="@style/CallButtonSubtitle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
