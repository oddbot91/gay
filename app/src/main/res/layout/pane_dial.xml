<?xml version="1.0" encoding="utf-8"?>
<!-- "Ring" pane: number field, live preview, contact matches, keypad and the call buttons.
     Wrapped in a ScrollView (fillViewport) so it still works on very short screens; on normal
     screens the spacer absorbs the free height and nothing scrolls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/pane_padding"
        android:paddingTop="@dimen/space_small"
        android:paddingRight="@dimen/pane_padding"
        android:paddingBottom="@dimen/pane_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/number_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Spacer with the same width as the backspace button keeps the number centred. -->
            <View
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/number_field"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:cursorVisible="true"
                android:gravity="center"
                android:hint="@string/number_hint"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"
                android:textSize="@dimen/number_text_size" />

            <ImageButton
                android:id="@+id/backspace"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_backspace"
                android:scaleType="center"
                android:src="@drawable/ic_backspace"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_tiny"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/preview_text_size"
            android:visibility="gone" />

        <TextView
            android:id="@+id/match_1"
            style="@style/MatchRow" />

        <TextView
            android:id="@+id/match_2"
            style="@style/MatchRow" />

        <TextView
            android:id="@+id/match_3"
            style="@style/MatchRow" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_small" />

        <!-- 3x4 keypad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/KeypadRow">

                <Button
                    android:id="@+id/key_1"
                    style="@style/KeypadKey"
                    android:text="@string/key_1" />

                <Button
                    android:id="@+id/key_2"
                    style="@style/KeypadKey"
                    android:text="@string/key_2" />

                <Button
                    android:id="@+id/key_3"
                    style="@style/KeypadKey"
                    android:text="@string/key_3" />
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <Button
                    android:id="@+id/key_4"
                    style="@style/KeypadKey"
                    android:text="@string/key_4" />

                <Button
                    android:id="@+id/key_5"
                    style="@style/KeypadKey"
                    android:text="@string/key_5" />

                <Button
                    android:id="@+id/key_6"
                    style="@style/KeypadKey"
                    android:text="@string/key_6" />
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <Button
                    android:id="@+id/key_7"
                    style="@style/KeypadKey"
                    android:text="@string/key_7" />

                <Button
                    android:id="@+id/key_8"
                    style="@style/KeypadKey"
                    android:text="@string/key_8" />

                <Button
                    android:id="@+id/key_9"
                    style="@style/KeypadKey"
                    android:text="@string/key_9" />
            </LinearLayout>

            <LinearLayout style="@style/KeypadRow">

                <Button
                    android:id="@+id/key_star"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_star"
                    android:text="@string/key_star" />

                <Button
                    android:id="@+id/key_0"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_zero"
                    android:text="@string/key_0" />

                <Button
                    android:id="@+id/key_hash"
                    style="@style/KeypadKey"
                    android:contentDescription="@string/cd_key_hash"
                    android:text="@string/key_hash" />
            </LinearLayout>
        </LinearLayout>

        <!-- RING INTERNT / RING PATIENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/call_internal"
                style="@style/CallButton"
                android:layout_marginEnd="@dimen/call_button_gap"
                android:background="@drawable/btn_primary">

                <TextView
                    style="@style/CallButtonTitle"
                    android:text="@string/call_internal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/call_patient"
                style="@style/CallButton"
                android:background="@drawable/btn_patient">

                <TextView
                    style="@style/CallButtonTitle"
                    android:text="@string/call_patient" />

                <TextView
                    style="@style/CallButtonSubtitle"
                    android:text="@string/call_patient_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- RING VÄXELN (full width) -->
        <LinearLayout
            android:id="@+id/call_switchboard"
            style="@style/CallButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:layout_marginTop="@dimen/call_button_gap"
            android:background="@drawable/btn_switchboard">

            <TextView
                style="@style/CallButtonTitle"
                android:text="@string/call_switchboard" />

            <TextView
                android:id="@+id/switchboard_sub"
                style="@style/CallButtonSubtitle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
